{
  "name": "monitor-de-salud",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n CLIENT,SERVER -c auto \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.5"
  }
  
}
